# Copy to `.env` and fill in. `.env` is gitignored — secrets NEVER get committed.
#
# Where secrets live:
#   - Home server (docker compose): this `.env` file on the host only.
#   - Cloudflare Pages (dashboard):  set VITE_API_BASE as a Pages build env var.
#   - Cloudflare Tunnel (remote):    TUNNEL_TOKEN comes from the Zero Trust
#                                    dashboard; store it here on the host only.
# Leave a value blank to be prompted/failed-fast by compose rather than run
# with a weak default.

# ---- Postgres ----
POSTGRES_DB=guardian
POSTGRES_USER=guardian
# Required. Generate one, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=

# ---- AdGuard Home control API ----
# The admin credentials you create in AdGuard's first-run wizard (:3000).
ADGUARD_USERNAME=admin
# Required. Generate one, e.g. `openssl rand -base64 24`.
ADGUARD_PASSWORD=
# Optional: your AdGuard server's public DNS hostname (e.g. dns.example.com).
# Enables per-device DoT/DoH "ClientID" endpoints for stable, IP-independent
# device identity. Leave blank if you only use plain DNS on the LAN.
ADGUARD_DNS_DOMAIN=

# ---- Dashboard auth ----
# Secret used to sign dashboard login tokens (JWT). Required.
# Generate one, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# The parent/admin login, seeded on first boot if no admin exists yet.
AUTH_ADMIN_USERNAME=admin
# Required. Generate/choose a strong one, e.g. `openssl rand -base64 24`.
AUTH_ADMIN_PASSWORD=

# ---- Router (optional, complements AdGuard) ----
# Set to "openwrt" to enable firewall-level enforcement (true internet cutoffs,
# DoT/VPN/bypass containment) and per-device bandwidth. Default "none".
ROUTER_PROVIDER=none
OPENWRT_URL=http://192.168.1.1
OPENWRT_USERNAME=root
# Router admin password (only needed when ROUTER_PROVIDER=openwrt). Host .env only.
OPENWRT_PASSWORD=
# AdGuard's LAN IP — used by containment to force all DNS to AdGuard.
ADGUARD_LAN_IP=

# ---- API ----
# How many days of raw DNS activity to keep before rolling up + pruning.
ACTIVITY_RETENTION_DAYS=14
# Comma-separated allowed origins for the dashboard + WebSocket. In production
# lock this to your Cloudflare Pages / tunnel hostname (not `*`).
CORS_ORIGIN=*
# Optional outbound alert webhook (Discord/Slack/ntfy) for critical alerts.
ALERT_WEBHOOK_URL=

# ---- Cloudflare Tunnel (optional remote access) ----
# From Cloudflare Zero Trust > Networks > Tunnels. Required only when running
# `docker compose --profile cloudflare up -d` (or `make tunnel`).
TUNNEL_TOKEN=

# ---- Cloudflare Pages deploy (used by `make deploy-cloudflare`) ----
# The dashboard's public API URL, baked into the build (your API tunnel host).
VITE_API_BASE=
# Cloudflare API token (Pages:Edit) + account id. If unset, wrangler will prompt
# an interactive login instead. Host-only; never committed.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
