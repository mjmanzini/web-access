# ---- Postgres ----
POSTGRES_DB=guardian
POSTGRES_USER=guardian
POSTGRES_PASSWORD=change-me-strong

# ---- AdGuard Home control API ----
# Credentials you set during AdGuard's first-run wizard at http://<host>:3000.
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=change-me-strong

# ---- API ----
# Comma-separated allowed origins for the dashboard + WebSocket. Lock this down
# to your Cloudflare Pages / tunnel hostname in production.
CORS_ORIGIN=*
# Optional outbound alert webhook (Discord/Slack/ntfy) for critical alerts.
ALERT_WEBHOOK_URL=

# ---- Cloudflare Tunnel (optional remote access) ----
# From Cloudflare Zero Trust > Networks > Tunnels. Used only with
# `docker compose --profile cloudflare up -d`.
TUNNEL_TOKEN=
